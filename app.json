{
  "expo": {
    "name": "SettleMe",
    "slug": "settleme",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "settleme",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.settleme.app",
      "infoPlist": {
        "NSCameraUsageDescription": "We use the camera so you can verify your identity by capturing your passport.",
        "NSPhotoLibraryUsageDescription": "We access your photo library so you can upload identity documents."
      }
    },
    "android": {
      "package": "com.settleme.app",
      "adaptiveIcon": { "backgroundColor": "#0B0F1A" },
      "edgeToEdgeEnabled": true,
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "web": { "bundler": "metro", "output": "static" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-image-picker", { "photosPermission": "We access your photo library so you can upload identity documents." }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
