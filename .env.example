# SettleMe — environment variables
# Copy to .env.local at the project root.

# --- Public (read on the device, prefixed EXPO_PUBLIC_) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=ey...
EXPO_PUBLIC_AGENT_FN_URL=https://YOUR-PROJECT.functions.supabase.co/agent-stream

# --- Server-only (Supabase edge function) — set via:
#       supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey...
